# Copiar a .env.local (desarrollo) o cargar como variables del hosting (producción).
# Solo las variables con prefijo VITE_ llegan al navegador.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# Google Cloud → Credentials → OAuth 2.0 Client ID (tipo "Aplicación web").
# Es el mismo client id que está configurado en Supabase → Auth → Providers → Google.
# Sin esto el botón oficial de Google no se puede renderizar y se cae al login
# por redirección.
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
