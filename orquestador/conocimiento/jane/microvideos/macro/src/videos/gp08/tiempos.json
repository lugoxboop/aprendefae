n": 15.46}, {"w": "hace", "ini": 15.52, "fin": 15.74}, {"w": "el", "ini": 15.78, "fin": 15.84}, {"w": "plan:", "ini": 15.94, "fin": 16.2}, {"w": "qué", "ini": 16.7, "fin": 16.8}, {"w": "se", "ini": 16.86, "fin": 16.94}, {"w": "cambia,", "ini": 17.04, "fin": 17.46}, {"w": "cuánto", "ini": 17.8, "fin": 18.1}, {"w": "cuesta", "ini": 18.2, "fin": 18.6}, {"w": "y", "ini": 18.94, "fin": 18.96}, {"w": "para", "ini": 19.06, "fin": 19.22}, {"w": "cuándo.", "ini": 19.3, "fin": 19.66}]}, {"ini": 20.26, "fin": 23.34, "texto": "Ejecuta: llegan los obreros y el horno nuevo.", "palabras": [{"w": "Ejecuta:", "ini": 20.26, "fin": 20.82}, {"w": "llegan", "ini": 21.22, "fin": 21.5}, {"w": "los", "ini": 21.54, "fin": 21.64}, {"w": "obreros", "ini": 21.72, "fin": 22.16}, {"w": "y", "ini": 22.4, "fin": 22.44}, {"w": "el", "ini": 22.5, "fin": 22.6}, {"w": "horno", "ini": 22.62, "fin": 22.92}, {"w": "nuevo.", "ini": 23.02, "fin": 23.34}]}, {"ini": 23.86, "fin": 28.72, "texto": "Mientras tanto vigila: ¿vamos a tiempo?, ¿el gasto va bien? Y corrige.", "palabras": [{"w": "Mientras", "ini": 23.86, "fin": 24.22}, {"w": "tanto", "ini": 24.28, "fin": 24.52}, {"w": "vigila:", "ini": 24.6, "fin": 25.02}, {"w": "¿vamos", "ini": 25.48, "fin": 25.76}, {"w": "a", "ini": 25.8, "fin": 25.84}, {"w": "tiempo?,", "ini": 25.92, "fin": 26.26}, {"w": "¿el", "ini": 26.62, "fin": 26.72}, {"w": "gasto", "ini": 26.78, "fin": 27.08}, {"w": "va", "ini": 27.12, "fin": 27.18}, {"w": "bien?", "ini": 27.26, "fin": 27.5}, {"w": "Y", "ini": 28.1, "fin": 28.14}, {"w": "corrige.", "ini": 28.24, "fin": 28.72}]}, {"ini": 29.28, "fin": 32.7, "texto": "Al final, cierra: recibe la cocina y firma.", "palabras": [{"w": "Al", "ini": 29.28, "fin": 29.36}, {"w": "final,", "ini": 29.44, "fin": 29.74}, {"w": "cierra:", "ini": 30.12, "fin": 30.48}, {"w": "recibe", "ini": 30.92, "fin": 31.3}, {"w": "la", "ini": 31.32, "fin": 31.38}, {"w": "cocina", "ini": 31.44, "fin": 31.88}, {"w": "y", "ini": 32.18, "fin": 32.22}, {"w": "firma.", "ini"