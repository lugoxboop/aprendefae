# Secretos de las Edge Functions. NINGUNO lleva prefijo VITE_: no se incrustan
# en el bundle del navegador, se leen del lado del servidor con Deno.env.get.
#
# En producción se ponen con:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#
# En local, se copia este archivo a supabase/functions/.env — que está en
# .gitignore y NUNCA se sube.

# Anthropic → console.anthropic.com → Settings → API keys.
# OJO: una suscripción Claude Pro NO sirve aquí. Son productos distintos: Pro es
# la interfaz de chat personal; esto necesita créditos de API, que se pagan por uso.
ANTHROPIC_API_KEY=sk-ant-TU-CLAVE

# Invocaciones por estudiante y día. Lo define Stanley.
# Si falta, la función usa un provisional de 10.
ASISTENTE_LIMITE_DIARIO=10

# El modelo. Por defecto claude-haiku-4-5, que es el de prueba de la tubería.
ASISTENTE_MODELO=claude-haiku-4-5
